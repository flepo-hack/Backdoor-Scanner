local function looksRandom(name)
	local core = name:lower():gsub("[%d_%-]", "")
	if #core < 3 or #core > 9 then
		return false
	end
	local stripped = core:gsub("[aeiouy]", "")
	return (#core - #stripped) <= 1
end

local function scoreRemote(remote)
	local name = remote.Name:lower()
	local score = 0
	local reasons = {}
	for kw, w in pairs(KEYWORDS) do
		if name:find(kw, 1, true) then
			score = score + w
			table.insert(reasons, kw .. "+" .. w)
		end
	end
	if looksRandom(remote.Name) then
		score = score + 2
		table.insert(reasons, "random-name+2")
	end
	return score, table.concat(reasons, " ")
end

local function copyText(t)
	local f = setclipboard or toclipboard
	if f then
		return pcall(f, t)
	end
	return false
end

local function rebuildTargets()
	local paths = { "LOCAL" }
	local refs = { nil }
	for _, r in ipairs(State.results) do
		local ok, full = pcall(function()
			return r.remote:GetFullName()
		end)
		if ok and full then
			table.insert(paths, "game." .. full)
			table.insert(refs, r.remote)
		end
	end
	State.targetPaths = paths
	State.targetRefs = refs
	if State.targetIndex > #paths then
		State.targetIndex = 1
	end
	if UI.updateTargetLabel then
		UI.updateTargetLabel()
	end
end

