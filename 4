local function hintBroadcast(message)
	task.spawn(function()
		local sent = false
		pcall(function()
			local tcs = game:GetService("TextChatService")
			local ch = tcs:FindFirstChild("TextChannels")
			local general = ch and ch:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync(message)
				sent = true
			end
		end)
		if not sent then
			pcall(function()
				local rs = game:GetService("ReplicatedStorage")
				local ev = rs:FindFirstChild("DefaultChatSystemChatEvents")
				local say = ev and ev:FindFirstChild("SayMessageRequest")
				if say then
					say:FireServer(message, "All")
					sent = true
				end
			end)
		end
		if sent then
			log("GOOD", "📢 hint lähetetty kaikille")
			toast("📢 HINT LÄHETETTY", message, THEME.good)
		else
			log("WARN", "chat-kanavaa ei löytynyt — hint näytetty vain sinulle")
			toast("💬 HINT (vain sinulle)", message, THEME.warn)
		end
	end)
end

local function markFound(m)
	if not m.reported then
		m.reported = true
		State.stats.confirmed = State.stats.confirmed + 1
		setStats()
		local ok, fullPath = pcall(function()
			return m.remote:GetFullName()
		end)
		log("GOOD", "✅ VARMA BACKDOOR → " .. tostring(fullPath))
		bigBanner(
			"🚨 BACKDOOR LÖYTYI 🚨",
			tostring(fullPath) .. "  [" .. m.remote.ClassName .. "]",
			THEME.good
		)
		playSound()
		if State.settings.autoHint and not State.hintSentThisScan then
			State.hintSentThisScan = true
			hintBroadcast(CONFIG.HintMessage)
		end
	end
	m.hits = m.hits + 1
end

local function runScan()
	if State.scanning then
		return
	end
	State.scanning = true
	State.hintSentThisScan = false
	State.stats = { total = 0, probed = 0, confirmed = 0 }
	State.results = {}
	State.targetPaths = { "LOCAL" }
	State.targetRefs = { nil }
	State.targetIndex = 1
	updateTargetLabel()
	renderResults()
	UI.ScanBtn.Text = "⛔ SKANNAA..."
	UI.ScanBtn.BackgroundColor3 = THEME.bad
	setProgress(0, "Selataan peliä...")
	log("INFO", "skannaus alkoi (herkkyys: " .. State.sensitivities[State.sensitivityIndex] .. ")")

	local t0 = os.clock()
	local remotes = {}
	local count = 0
	for _, obj in ipairs(game:GetDescendants()) do
		count = count + 1
		if obj.ClassName == "RemoteEvent" or obj.ClassName == "RemoteFunction" then
			table.insert(remotes, obj)
		end
		if count % CONFIG.EnumChunk == 0 then
			setProgress(0.12 * math.min(1, count / 20000), "Selataan peliä... " .. count .. " objektia")
			task.wait()
		end
		if #remotes >= CONFIG.MaxRemotes then
			break
		end
	end
	State.stats.total = #remotes
	log("INFO", "löytyi " .. #remotes .. " remotea")
	setProgress(0.15, "Testataan 0/" .. #remotes)

	local markers = {}
	local confirmedList = {}
	local order = {}

	local instConn
	instConn = workspace.DescendantAdded:Connect(function(child)
		local g = child.Name:match("^JZX_(%x+)$")
		if g and markers[g] then
			markFound(markers[g])
		end
	end)
	local attrConn
	attrConn = workspace.AttributeChanged:Connect(function(attr)
		local g = attr:match("^JZX_(%x+)$")
		if g and markers[g] then
			markFound(markers[g])
		end
	end)

	local minScore = State.sensMinScore[State.sensitivityIndex]
	local scored = {}
	for _, r in ipairs(remotes) do
		local s, why = scoreRemote(r)
		if s >= minScore then
			table.insert(scored, { remote = r, score = s, reason = why })
		end
	end
	table.sort(scored, function(a, b)
		return a.score > b.score
	end)
	log("INFO", "testataan " .. #scored .. "/" .. #remotes .. " remotea suodatuksen jälkeen")

	local sweepDeadline = t0 + CONFIG.SweepMaxTime
	for i, entry in ipairs(scored) do
		if State.destroyed then
			break
		end
		if os.clock() > sweepDeadline then
			log("WARN", "aikaraja täynnä — keskeytetään")
			break
		end
		local g = newGuid()
		local m = {
			remote = entry.remote,
			score = entry.score,
			reason = entry.reason,
			guid = g,
			hits = 0,
			reported = false,
		}
		markers[g] = m
		table.insert(order, m)
		local payload = 'workspace:SetAttribute("JZX_'
			.. g
			.. '",true) Instance.new("StringValue",workspace).Name="JZX_'
			.. g
			.. '"'
		task.spawn(function()
			if entry.remote:IsA("RemoteEvent") then
				pcall(entry.remote.FireServer, entry.remote, payload)
			else
				pcall(entry.remote.InvokeServer, entry.remote, payload)
			end
		end)
		State.stats.probed = State.stats.probed + 1
		if i % 5 == 0 or i == #scored then
			setProgress(
				0.15 + 0.75 * (i / #scored),
				("Testataan remoteja %d/%d — varmoja: %d"):format(i, #scored, State.stats.confirmed)
			)
			UI.StatsLbl.Text = ("yhteensä %d | suodatettu pois %d | testattu %d | %.1fs"):format(
				#remotes,
				#remotes - #scored,
				i,
				os.clock() - t0
			)
			setStats()
		end
		if i % CONFIG.BatchSize == 0 then
			task.wait(CONFIG.BatchPause)
		else
			task.wait(CONFIG.ProbeDelay)
		end
	end

	setProgress(0.92, "Odotetaan palautetta remoteilta...")
	local grace = (State.stats.confirmed > 0) and CONFIG.ExtraWindow or CONFIG.ConfirmWindow
	local graceEnd = os.clock() + grace
	while os.clock() < graceEnd do
		task.wait(0.1)
	end
	instConn:Disconnect()
	attrConn:Disconnect()

	for _, m in ipairs(order) do
		local ok, fullPath = pcall(function()
			return m.remote:GetFullName()
		end)
		m.fullPath = ok and fullPath or (m.remote.Name .. "?")
		m.pathShort = m.fullPath
		if #m.pathShort > 40 then
			m.pathShort = "…" .. m.pathShort:sub(-39)
		end
	end

	table.sort(order, function(a, b)
		local ac = a.hits > 0
		local bc = b.hits > 0
		if ac ~= bc then
			return ac
		end
		if a.hits ~= b.hits then
			return a.hits > b.hits
		end
		return a.score > b.score
	end)

	State.results = order
	for _, m in ipairs(order) do
		if m.hits > 0 then
			table.insert(confirmedList, m)
		end
	end
	renderResults()
	rebuildTargets()

	local elapsed = os.clock() - t0
	setProgress(1, ("Valmis %.1fs"):format(elapsed))
	UI.StatsLbl.Text = ("valmis: %d testattu | %d varmaa | %.1fs"):format(
		State.stats.probed,
		State.stats.confirmed,
		elapsed
	)
	setStats()

	if #confirmedList > 0 then
		setStatus(("VALMIS — %d varma(a) backdooria! Avaa EXEC.")format(#confirmedList))
		log("GOOD", "skannaus valmis: " .. #confirmedList .. " varmaa " .. string.format("%.1fs", elapsed))
	else
		setStatus("Valmis — ei löytynyt hyödyllisiä remoteja. Kokeile HIGH.")
		log("INFO", "skannaus valmis: ei varmoja (" .. string.format("%.1fs", elapsed) .. ")")
		toast("SKANNAUS VALMIS", "ei varmoja backdooreja — kokeile HIGH-herkkyyttä", THEME.dim)
	end

	UI.ScanBtn.Text = "🔄 UUSI SKANNAUS"
	UI.ScanBtn.BackgroundColor3 = THEME.accent
	State.scanning = false
end

UI.ScanBtn.MouseButton1Click:Connect(function()
