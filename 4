	if #lines == 0 then
		toast("Nothing to copy", "Run a scan first.", THEME.warn)
		return
	end
	if copyText(table.concat(lines, "\n")) then
		toast("Copied " .. #lines .. " results", "Full paths + scores on clipboard.", THEME.accent)
	else
		toast("No clipboard API", "This executor lacks setclipboard.", THEME.warn)
	end
end)

