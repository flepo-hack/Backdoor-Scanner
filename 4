local function runLocal(code)
	local f = loadstring or load
	if not f then
		outputLine("❌ eksekutorissa ei ole loadstringia")
		return
	end
	local fn, err = f(code)
	if not fn then
		outputLine("❌ compile-virhe: " .. tostring(err))
		log("BAD", "paikallinen kompilointi epäonnistui")
		return
	end
	local ok, res = pcall(fn)
	if ok then
		outputLine("✅ ajettiin clientissa, palautti: " .. tostring(res))
		log("GOOD", "paikallinen ajo ok")
	else
		outputLine("❌ ajo-virhe: " .. tostring(res))
		log("BAD", "paikallinen virhe: " .. tostring(res))
	end
end

local function watchExecMarker(g)
	local conn
	conn = workspace.AttributeChanged:Connect(function(attr)
		if attr == "JZXE_" .. g then
			conn:Disconnect()
			outputLine("✅ SERVERI VAHVISTI SUORITUKSEN")
			log("GOOD", "ajo vahvistettu attribuuttimerkillä")
			playSound()
		end
	end)
	task.delay(CONFIG.ExecConfirmWindow, function()
		if conn.Connected then
			conn:Disconnect()
			outputLine("⚠ ei vahvistusta " .. CONFIG.ExecConfirmWindow .. "s sisällä (koodi voi silti olla ajettu)")
			log("WARN", "ajoa ei voitu vahvistaa")
		end
	end)
end

local function executeCurrent()
	if State.executing then
		outputLine("⏳ jo käynnissä...")
		return
	end
	State.executing = true
	task.delay(3, function()
		State.executing = false
	end)
	local mode = State.modes[State.modeIndex]
	local code
	if mode == "REQUIRE" then
		local id = UI.RequireIdBox.Text:match("%d+")
		if not id then
			outputLine("❌ virheellinen asset-id")
			return
		end
		local args = UI.RequireArgsBox.Text
		if args == "" then
			args = '"' .. PlayerName .. '"'
		end
		code = ("require(%s)(%s)"):format(id, args)
	else
		code = UI.CodeBox.Text
		if code == "" then
			outputLine("❌ tyhjä koodi")
			return
		end
	end
	local confirmGuid
	if State.settings.confirmExec then
		confirmGuid = newGuid()
		code = code .. '\nworkspace:SetAttribute("JZXE_' .. confirmGuid .. '",true)'
	end
	local ref = State.targetRefs[State.targetIndex]
	if ref == nil then
		runLocal(code)
	else
		outputLine("📤 lähetetään " .. #code .. " tavua → " .. ref.Name)
		task.spawn(function()
			if confirmGuid then
				watchExecMarker(confirmGuid)
			end
			if ref:IsA("RemoteEvent") then
				local ok = pcall(ref.FireServer, ref, code)
				outputLine(ok and "📨 RemoteEvent laukaistu" or "❌ FireServer epäonnistui")
			else
				local ok, res = pcall(ref.InvokeServer, ref, code)
				outputLine(ok and ("📨 kutsuttu, palautti: " .. tostring(res)) or ("❌ InvokeServer epäonnistui: " .. tostring(res)))
			end
			log("INFO", "payload lähetetty kohteeseen " .. ref.Name .. " (" .. mode .. ")")
		end)
	end
end

