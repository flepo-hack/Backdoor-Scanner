		TextSize = 11,
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Parent = SetupPage,
	})
	local btn = create("TextButton", {
		Size = UDim2.new(0, 96, 0, 28),
		Position = UDim2.new(1, -96, 0, y),
		BackgroundColor3 = THEME.good,
		Text = "ON",
		TextColor3 = Color3.fromRGB(8, 14, 10),
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Parent = SetupPage,
	})
	corner(btn, 7)
	hoverify(btn, THEME.good, Color3.fromRGB(45, 165, 90))
	btn.MouseButton1Click:Connect(function()
		State.settings[key] = not State.settings[key]
		if State.settings[key] then
			btn.BackgroundColor3 = THEME.good
			btn.Text = "ON"
			btn.TextColor3 = Color3.fromRGB(8, 14, 10)
		else
			btn.BackgroundColor3 = THEME.panel2
			btn.Text = "OFF"
			btn.TextColor3 = THEME.dim
		end
		log("INFO", "asetus " .. key .. " = " .. tostring(State.settings[key]))
	end)
	return btn
end

