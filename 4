end)

local function collectGameRequires()
	if State.collecting then
		return
	end
	State.collecting = true
	UI.CollectBtn.Text = "⏳ LUETAAN..."
	log("INFO", "etsitään pelin require-ID:t...")
	local t0 = os.clock()
	local found = {}
	local scanned = 0
	local readable = 0
	local count = 0
	for _, obj in ipairs(game:GetDescendants()) do
		count = count + 1
		if obj:IsA("ModuleScript") or obj:IsA("LocalScript") or obj:IsA("Script") then
			scanned = scanned + 1
			local ok, src = pcall(function()
				return obj.Source
			end)
			if ok and type(src) == "string" and #src > 0 then
				readable = readable + 1
				for id in src:gmatch("require%s*%(%s*(%d+)%s*%)") do
					if #id >= 5 then
						if not found[id] then
							found[id] = { id = id, count = 0 }
						end
						found[id].count = found[id].count + 1
					end
				end
			end
		end
		if count % CONFIG.EnumChunk == 0 then
			task.wait()
		end
	end
	local list = {}
	for id, data in pairs(found) do
		data.source = "?"
		table.insert(list, data)
	end
	table.sort(list, function(a, b)
		if a.count ~= b.count then
			return a.count > b.count
		end
		return a.id < b.id
	end)
	while #list > 30 do
		table.remove(list)
	end
	for _, rq in ipairs(list) do
		rq.source = "require-lähde"
	end
	State.requires = list
	renderRequires()
	State.collecting = false
	UI.CollectBtn.Text = "🔄 HAE"
	if readable == 0 then
		UI.ReqCountLbl.Text = "ei luettavia Sourceja tässä eksekutorissa"
		log("WARN", "Source ei luettavissa — require-haku ei toimi täällä")
		toast("⚠ EI LÄHDEKOODIA", "Eksekutori ei paljasta skriptien Sourcea — haku tyhjä.", THEME.warn)
	else
		UI.ReqCountLbl.Text = #list .. " ID:tä · " .. readable .. "/" .. scanned .. " luettu · " .. string.format("%.1fs", os.clock() - t0)
		log("GOOD", "require-haku: " .. #list .. " uniikkia ID:tä (" .. readable .. " lähdekoodia luettu)")
		toast("💡 VALMIS", #list .. " require-ID:tä löytyi pelin koodista.", THEME.accent2)
	end
end

