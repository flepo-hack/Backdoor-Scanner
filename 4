end

local function looksRandom(name)
	local core = name:lower():gsub("[%d_%-]", "")
	if #core < 3 or #core > 9 then
		return false
	end
	local stripped = core:gsub("[aeiouy]", "")
	return (#core - #stripped) <= 1
end

local function scoreRemote(remote)
	local name = remote.Name:lower()
	local score = 0
	local reasons = {}
	for kw, w in pairs(KEYWORDS) do
		if name:find(kw, 1, true) then
			score = score + w
			table.insert(reasons, kw .. "+" .. w)
		end
	end
	if looksRandom(remote.Name) then
		score = score + 2
		table.insert(reasons, "random-name+2")
	end
	return score, table.concat(reasons, " ")
end

local function markerPayload(prefix, guid)
	return table.concat({
		'pcall(function() workspace:SetAttribute("' .. prefix .. guid .. '",true) end)',
		'pcall(function() local s=Instance.new("StringValue") s.Name="' .. prefix .. guid .. '" s.Parent=workspace end)',
		'pcall(function() local s=Instance.new("StringValue") s.Name="' .. prefix .. guid .. '" s.Parent=game:GetService("Lighting") end)',
	}, " ")
end

-- different argument shapes real backdoors accept; each carries the same marker code
local function probeVariants(payload)
	return {
		payload,
		{ payload },
		{ code = payload },
		{ Code = payload },
		{ source = payload },
		{ src = payload },
		"loadstring|" .. payload,
		"run:" .. payload,
	}
end

local function sendPayload(remote, payload)
	if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
		return pcall(remote.FireServer, remote, payload)
	end
	return pcall(remote.InvokeServer, remote, payload)
end

-- score structural signals beyond the name: parent location, sibling names, argument hints
local STRUCT_BONUS = {
	ReplicatedStorage = 1,
	ReplicatedFirst = 1,
	Lighting = 2,
	ServerStorage = 3,
	ServerScriptService = 3,
}
local function structuralScore(remote)
	local bonus = 0
	local tags = {}
	local okParent, parent = pcall(function()
		return remote.Parent
	end)
	if okParent and parent then
		local okName, pname = pcall(function()
			return parent.Name
		end)
		if okName and pname then
			local b = STRUCT_BONUS[pname]
			if b then
				bonus = bonus + b
				table.insert(tags, "in-" .. pname .. "+" .. b)
			end
			if pname:lower():find("backdoor", 1, true) or pname:lower():find("remote", 1, true) then
				bonus = bonus + 2
				table.insert(tags, "suspicious-parent+2")
			end
		end
		local okSib, sibs = pcall(function()
			return parent:GetChildren()
		end)
		if okSib and sibs then
			for _, s in ipairs(sibs) do
				if s ~= remote and s:IsA("ModuleScript") then
					local n = s.Name:lower()
					if n:find("mainmodule", 1, true) or n:find("backdoor", 1, true) or n:find("serverside", 1, true) then
						bonus = bonus + 3
						table.insert(tags, "bd-module-sibling+3")
						break
					end
				end
			end
		end
	end
	return bonus, table.concat(tags, " ")
end

local function harvestRequireIds(obj, found, counters)
	counters.scanned = counters.scanned + 1
	local ok, src = pcall(function()
		return obj.Source
	end)
	if ok and type(src) == "string" and #src > 0 then
		counters.readable = counters.readable + 1
		for id in src:gmatch("require%s*%(%s*(%d+)%s*%)") do
			if #id >= 5 then
				if not found[id] then
					found[id] = { id = id, count = 0 }
				end
				found[id].count = found[id].count + 1
			end
		end
	end
end

local History
do
	local cache = {}
	local persistOk = nil

	local function loadStore()
		pcall(function()
			if readfile and isfile and isfile(CONFIG.HistoryFile) then
				local raw = readfile(CONFIG.HistoryFile)
				local data = HttpService:JSONDecode(raw)
				if type(data) == "table" then
					cache = data
				end
			end
		end)
		for _, e in ipairs(cache) do
			e.placeId = tonumber(e.placeId) or 0
			e.name = (type(e.name) == "string") and e.name or nil
			e.remotes = (type(e.remotes) == "table") and e.remotes or {}
			e.reqs = (type(e.reqs) == "table") and e.reqs or {}
			e.last = tonumber(e.last) or 0
		end
	end

	local function saveStore()
		pcall(function()
			if writefile then
				writefile(CONFIG.HistoryFile, HttpService:JSONEncode(cache))
				persistOk = true
			else
				persistOk = false
			end
		end)
	end

	loadStore()

	local function sortByNewest()
		table.sort(cache, function(a, b)
			return (a.last or 0) > (b.last or 0)
		end)
	end

	local function findByPlace(pid)
		for _, e in ipairs(cache) do
			if e.placeId == pid then
				return e
			end
		end
		return nil
	end

	local function fetchGameName(pid)
		local ok, info = pcall(function()
			return game:GetService("MarketplaceService"):GetProductInfo(pid)
		end)
		if ok and type(info) == "table" and info.Name then
			return info.Name
		end
		return nil
	end

	History = {
		GetAll = function()
			return cache
		end,

		IsPersisted = function()
			return persistOk ~= false
		end,

		Record = function(remotePath, className)
			local pid = game.PlaceId
			local entry = findByPlace(pid)
			if not entry then
				entry = {
					placeId = pid,
					name = nil,
					remotes = {},
					reqs = {},
					last = 0,
				}
				table.insert(cache, entry)
			end
			entry.last = os.time()
			if not entry.name then
				entry.name = fetchGameName(pid)
			end
			if #entry.remotes < 25 and not table.find(entry.remotes, remotePath) then
				table.insert(entry.remotes, remotePath .. " [" .. tostring(className) .. "]")
			end
			sortByNewest()
			while #cache > CONFIG.HistoryCap do
				table.remove(cache)
			end
			saveStore()
			if UI.renderHistory then
				UI.renderHistory()
			end
			return entry
		end,

		AttachRequires = function(idList)
			local entry = findByPlace(game.PlaceId)
			if not entry then
				return
			end
			entry.reqs = {}
			for i, rq in ipairs(idList) do
				if i > 10 then
					break
				end
				table.insert(entry.reqs, rq.id)
			end
			saveStore()
		end,

		RefreshNames = function()
			task.spawn(function()
				local changed = false
				for _, e in ipairs(cache) do
					if not e.name then
						local n = fetchGameName(e.placeId)
						if n then
							e.name = n
							changed = true
						end
						task.wait(0.3)
					end
				end
				if changed then
					saveStore()
					if UI.renderHistory and not State.destroyed then
						UI.renderHistory()
					end
				end
			end)
		end,

		Remove = function(placeId)
			for i, e in ipairs(cache) do
				if e.placeId == placeId then
					table.remove(cache, i)
					break
				end
			end
			saveStore()
		end,

		ClearAll = function()
			cache = {}
			saveStore()
		end,
	}
end

