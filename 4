local function runScanCore()
	State.hintSentThisScan = false
	State.stats = { total = 0, probed = 0, confirmed = 0 }
	State.results = {}
	State.resultSearch = ""
	if UI.SearchBox then
		UI.SearchBox.Text = ""
	end
	State.targetPaths = { "LOCAL" }
	State.targetRefs = { nil }
	State.targetIndex = 1
	updateTargetLabel()
	renderResults()
	setProgress(0, "Walking the game tree...")
	log("INFO", "scan started (sensitivity: " .. State.sensitivities[State.sensitivityIndex] .. ")")

	local t0 = os.clock()
	local remotes = {}
	local reqFound = {}
	local reqCounters = { scanned = 0, readable = 0 }
	local count = 0
	for _, obj in ipairs(game:GetDescendants()) do
		count = count + 1
		local cn = obj.ClassName
		if cn == "RemoteEvent" or cn == "RemoteFunction" or cn == "UnreliableRemoteEvent" then
			table.insert(remotes, obj)
		elseif cn == "ModuleScript" or cn == "LocalScript" or cn == "Script" then
			harvestRequireIds(obj, reqFound, reqCounters)
		end
		if count % CONFIG.EnumChunk == 0 then
			setProgress(0.12 * math.min(1, count / 20000), "Walking the game tree... " .. count .. " objects")
			task.wait()
		end
		if #remotes >= CONFIG.MaxRemotes then
			break
		end
	end
	State.stats.total = #remotes
	log("INFO", "found " .. #remotes .. " remotes · read " .. reqCounters.readable .. " script sources")

	local reqList = {}
	for _, data in pairs(reqFound) do
		table.insert(reqList, data)
	end
	table.sort(reqList, function(a, b)
		if a.count ~= b.count then
			return a.count > b.count
		end
		return a.id < b.id
	end)
	while #reqList > 30 do
		table.remove(reqList)
	end
	State.requires = reqList
	renderRequires()
	UI.ReqCountLbl.Text = #reqList .. " ids · " .. reqCounters.readable .. "/" .. reqCounters.scanned .. " sources read"
	if #reqList > 0 then
		log("GOOD", "harvested " .. #reqList .. " unique require() ids — see REQ tab")
	end

	setProgress(0.15, "Probing 0/" .. #remotes)

	local markers = {}
	local confirmedList = {}
	local order = {}
	State.results = order

	local instConn
	instConn = game.DescendantAdded:Connect(function(child)
		local g = child.Name:match("^JZX_(%x+)$")
		if g and markers[g] then
			markFound(markers[g])
		end
	end)
	local attrConn
	attrConn = workspace.AttributeChanged:Connect(function(attr)
		local g = attr:match("^JZX_(%x+)$")
		if g and markers[g] then
			markFound(markers[g])
		end
	end)

	local minScore = State.sensMinScore[State.sensitivityIndex]
	local scored = {}
	for _, r in ipairs(remotes) do
		local s, why = scoreRemote(r)
		local sb, stags = structuralScore(r)
		if sb > 0 then
			s = s + sb
			why = why .. (why ~= "" and " " or "") .. stags
		end
		if s >= minScore then
			table.insert(scored, { remote = r, score = s, reason = why })
		end
	end
	table.sort(scored, function(a, b)
		return a.score > b.score
	end)
	log("INFO", "probing " .. #scored .. "/" .. #remotes .. " remotes after filtering")

	local sweepDeadline = t0 + CONFIG.SweepMaxTime
	for i, entry in ipairs(scored) do
		if State.destroyed then
			break
		end
		if os.clock() > sweepDeadline then
			log("WARN", "sweep deadline reached — stopping early")
			break
		end
		local g = newGuid()
		local okPath, fullPath = pcall(function()
			return entry.remote:GetFullName()
		end)
		local m = {
			remote = entry.remote,
			score = entry.score,
			reason = entry.reason,
			displayReason = entry.reason ~= "" and entry.reason or "no name signals",
			fullPath = okPath and fullPath or (entry.remote.Name .. "?"),
			guid = g,
			hits = 0,
			reported = false,
		}
		markers[g] = m
		table.insert(order, m)
		local payload = markerPayload("JZX_", g)
		task.spawn(function()
			local variants = probeVariants(payload)
			local isFunc = entry.remote:IsA("RemoteFunction")
			for vi, v in ipairs(variants) do
				if m.hits > 0 then
					break
				end
				if isFunc then
					local ok, res = sendPayload(entry.remote, v)
					if not ok and type(res) == "string" then
						m.errorSignal = res
					elseif ok and res ~= nil then
						m.returnSignal = res
						m.workingShape = v
					end
				else
					sendPayload(entry.remote, v)
				end
				if m.hits > 0 and m.workingShape == nil then
					m.workingShape = v
				end
				if vi < #variants then
					task.wait()
				end
			end
		end)
		State.stats.probed = State.stats.probed + 1
		if i % 5 == 0 or i == #scored then
			setProgress(
				0.15 + 0.73 * (i / #scored),
				("Probing remotes %d/%d — hits: %d"):format(i, #scored, State.stats.confirmed)
			)
			UI.StatsLbl.Text = ("total %d | filtered out %d | probed %d | %.1fs"):format(
				#remotes,
				#remotes - #scored,
				i,
				os.clock() - t0
			)
			setStats()
		end
		if State.stats.confirmed >= CONFIG.MaxHitsPerScan then
			log("GOOD", "early exit — " .. State.stats.confirmed .. " confirmed backdoors is plenty")
			break
		end
		if i % CONFIG.BatchSize == 0 then
			task.wait()
		end
	end

	setProgress(0.88, "Waiting for marker callbacks...")
	local grace = (State.stats.confirmed > 0) and CONFIG.ExtraWindow or CONFIG.ConfirmWindow
	local graceEnd = os.clock() + grace
	while os.clock() < graceEnd do
		task.wait(0.1)
	end
	instConn:Disconnect()
	attrConn:Disconnect()

	for _, m in ipairs(order) do
		if m.errorSignal then
			m.score = m.score + 2
			m.displayReason = m.displayReason .. " · error-response+2"
		end
		if m.returnSignal ~= nil then
			m.score = m.score + 2
			m.displayReason = m.displayReason .. " · returned-value+2"
		end
	end

	local verifyList = {}
	for _, m in ipairs(order) do
		if m.hits > 0 then
			table.insert(verifyList, m)
		end
	end
	if #verifyList > 0 and not State.destroyed then
		setProgress(0.92, "Verifying " .. #verifyList .. " hit(s) with fresh markers...")
		log("INFO", "verification pass: re-probing " .. #verifyList .. " hit(s)")
		local vMarkers = {}
		for _, m in ipairs(verifyList) do
			m.verifyGuid = newGuid()
			m.verified = false
			vMarkers[m.verifyGuid] = m
		end
		local vInst
		vInst = game.DescendantAdded:Connect(function(child)
			local g = child.Name:match("^JZV_(%x+)$")
			if g and vMarkers[g] then
				vMarkers[g].verified = true
			end
		end)
		local vAttr
		vAttr = workspace.AttributeChanged:Connect(function(attr)
			local g = attr:match("^JZV_(%x+)$")
			if g and vMarkers[g] then
				vMarkers[g].verified = true
			end
		end)
		for _, m in ipairs(verifyList) do
			local payload = markerPayload("JZV_", m.verifyGuid)
			task.spawn(function()
				sendPayload(m.remote, payload)
			end)
		end
		local vEnd = os.clock() + 4
		while os.clock() < vEnd and not State.destroyed do
			task.wait(0.1)
		end
		vInst:Disconnect()
		vAttr:Disconnect()
		for _, m in ipairs(verifyList) do
			if m.verified then
				m.displayReason = "VERIFIED — executes code server-side · press EXEC"
				log("GOOD", "verified: " .. m.fullPath)
			else
				m.displayReason = "hit, but re-check failed (laggy or one-shot channel)"
				log("WARN", "unverified hit: " .. m.fullPath)
			end
		end
	end

	table.sort(order, function(a, b)
		local ac = a.hits > 0
		local bc = b.hits > 0
		if ac ~= bc then
			return ac
		end
		if ac and bc then
			local av = a.verified and 1 or 0
			local bv = b.verified and 1 or 0
			if av ~= bv then
				return av > bv
			end
		end
		if a.hits ~= b.hits then
			return a.hits > b.hits
		end
		return a.score > b.score
	end)

	for _, m in ipairs(order) do
		if m.hits > 0 then
			table.insert(confirmedList, m)
		end
	end
	renderResults()
	rebuildTargets()

	local elapsed = os.clock() - t0
	setProgress(1, ("Done in %.1fs"):format(elapsed))
	UI.StatsLbl.Text = ("done: %d probed | %d confirmed | %.1fs"):format(
		State.stats.probed,
		State.stats.confirmed,
		elapsed
	)
	setStats()

	if #confirmedList > 0 then
		setStatus(("DONE — %d confirmed backdoor(s)! Open EXEC."):format(#confirmedList))
		log("GOOD", "scan done: " .. #confirmedList .. " confirmed in " .. string.format("%.1fs", elapsed))
		History.AttachRequires(reqList)
	else
		setStatus("Done — no exploitable remotes found. Try HIGH.")
		log("INFO", "scan done: nothing confirmed (" .. string.format("%.1fs", elapsed) .. ")")
		toast("SCAN COMPLETE", "No confirmed backdoors — try HIGH sensitivity.", THEME.dim)
	end
end

