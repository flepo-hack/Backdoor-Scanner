-- RGB animaatio funktio
local function createRGBStroke(parent)
    local stroke = Instance.new("UIStroke")
    stroke.Parent = parent
    stroke.Thickness = 3
    local hue = 0
    spawn(function()
        while stroke.Parent do
            hue = (hue + 2) % 360
            TweenService:Create(stroke, TweenInfo.new(0.5), {Color = Color3.fromHSV(hue / 360, 1, 1)}):Play()
            task.wait(0.1)
        end
    end)
    return stroke
end

