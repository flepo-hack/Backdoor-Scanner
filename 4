	local btn = create("TextButton", {
		Size = UDim2.new(0, 96, 0, 28),
		Position = UDim2.new(1, -96, 0, y),
		Text = "",
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Parent = SetupPage,
	})
	corner(btn, 7)
	local function refresh()
		if State.settings[key] then
			btn.BackgroundColor3 = THEME.good
			btn.Text = "ON"
			btn.TextColor3 = Color3.fromRGB(8, 14, 10)
		else
			btn.BackgroundColor3 = THEME.panel2
			btn.Text = "OFF"
			btn.TextColor3 = THEME.dim
		end
	end
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {
			BackgroundColor3 = State.settings[key] and Color3.fromRGB(45, 165, 90) or THEME.btnHover,
		}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {
			BackgroundColor3 = State.settings[key] and THEME.good or THEME.panel2,
		}):Play()
	end)
	refresh()
	bindClick(btn, function()
		State.settings[key] = not State.settings[key]
		refresh()
		log("INFO", "setting " .. key .. " = " .. tostring(State.settings[key]))
	end)
end

