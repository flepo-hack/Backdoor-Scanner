	if State.scanning then
		log("WARN", "scan ignored — one already running")
		return
	end
	State.scanning = true
	UI.ScanStatus.Text = "Engine starting..."
	UI.ScanBtn.Text = "SCANNING..."
	UI.ScanBtn.BackgroundColor3 = THEME.bad
