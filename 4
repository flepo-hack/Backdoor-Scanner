local function log(level, msg)
	local stamp = os.date("%H:%M:%S")
	table.insert(State.logs, { level = level, msg = msg, stamp = stamp })
	if #State.logs > 250 then
		table.remove(State.logs, 1)
	end
	print(("%s JzScanner %s %s"):format(stamp, LOG_ICONS[level], msg))
	if UI.renderLogs and not State.destroyed then
		UI.renderLogs()
	end
end

local function bindClick(btn, fn)
	State.bindCount = State.bindCount + 1
	pcall(function()
		btn:SetAttribute("JZ_WIRED", true)
	end)
	local last = 0
	local function fire(...)
		local now = tick()
		if now - last < 0.25 then
			return
		end
		last = now
		local ok, err = pcall(fn, ...)
		if not ok then
			log("BAD", "button error: " .. tostring(err))
		end
	end
	btn.MouseButton1Click:Connect(fire)
	btn.Activated:Connect(fire)
	btn.TouchTap:Connect(fire)
end

local function playSound()
	if not State.settings.sound then
		return
	end
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = CONFIG.SoundId
		s.Volume = 0.5
		s.Parent = SoundService
		s:Play()
		task.delay(3, function()
			s:Destroy()
		end)
	end)
end

local function outputLine(msg)
	table.insert(State.outBuffer, msg)
	while #State.outBuffer > 7 do
		table.remove(State.outBuffer, 1)
	end
	if UI.outLabel then
		UI.outLabel.Text = table.concat(State.outBuffer, "\n")
	end
end

local function copyText(t)
