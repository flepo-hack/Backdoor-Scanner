local function runLocal(code)
	local f = loadstring or load
	if not f then
		outputLine("❌ executor has no loadstring")
		return
	end
	local fn, err = f(code)
	if not fn then
		outputLine("❌ compile error: " .. tostring(err))
		log("BAD", "local compile failed")
		return
	end
	local ok, res = pcall(fn)
	if ok then
		outputLine("✅ ran locally, returned: " .. tostring(res))
		log("GOOD", "local execution ok")
	else
		outputLine("❌ runtime error: " .. tostring(res))
		log("BAD", "local runtime error: " .. tostring(res))
	end
end

local function watchExecMarker(g)
	local conn
	conn = workspace.AttributeChanged:Connect(function(attr)
		if attr == "JZXE_" .. g then
			conn:Disconnect()
			outputLine("✅ SERVER EXECUTION CONFIRMED")
			log("GOOD", "execution confirmed via attribute marker")
			playSound()
		end
	end)
	task.delay(CONFIG.ExecConfirmWindow, function()
		if conn.Connected then
			conn:Disconnect()
			outputLine("⚠ no confirm in " .. CONFIG.ExecConfirmWindow .. "s (code may still have run)")
			log("WARN", "execution unconfirmed")
		end
	end)
end

local function executeCurrent()
	if State.executing then
		outputLine("⏳ already executing...")
		return
	end
	State.executing = true
	task.delay(3, function()
		State.executing = false
	end)
	local mode = State.modes[State.modeIndex]
	local code
	if mode == "REQUIRE" then
		local id = UI.RequireIdBox.Text:match("%d+")
		if not id then
			outputLine("❌ invalid asset id")
			return
		end
		local args = UI.RequireArgsBox.Text
		if args == "" then
			args = '"' .. PlayerName .. '"'
		end
		code = ("require(%s)(%s)"):format(id, args)
	else
		code = UI.CodeBox.Text
		if code == "" then
			outputLine("❌ empty code")
			return
		end
	end
	local confirmGuid
	if State.settings.confirmExec then
		confirmGuid = newGuid()
		code = code .. '\nworkspace:SetAttribute("JZXE_' .. confirmGuid .. '",true)'
	end
	local ref = State.targetRefs[State.targetIndex]
	if ref == nil then
		runLocal(code)
	else
		outputLine("📤 sending " .. #code .. " bytes → " .. ref.Name)
		task.spawn(function()
			if confirmGuid then
				watchExecMarker(confirmGuid)
			end
			if ref:IsA("RemoteEvent") then
				local ok = pcall(ref.FireServer, ref, code)
				outputLine(ok and "📨 fired RemoteEvent" or "❌ FireServer failed")
			else
				local ok, res = pcall(ref.InvokeServer, ref, code)
				outputLine(ok and ("📨 invoked, returned: " .. tostring(res)) or ("❌ InvokeServer failed: " .. tostring(res)))
			end
			log("INFO", "sent payload to " .. ref.Name .. " (" .. mode .. ")")
		end)
	end
end

