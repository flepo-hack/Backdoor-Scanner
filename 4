			BorderSizePixel = 0,
			AutoButtonColor = false,
			Parent = row,
		})
		corner(copyB, 6)
		hoverify(copyB, THEME.accent, Color3.fromRGB(0, 190, 172))
		local delB = create("TextButton", {
			Size = UDim2.new(0, 54, 0, 26),
			Position = UDim2.new(1, -60, 0.5, -13),
			BackgroundColor3 = THEME.bad,
			Text = "DEL",
			TextColor3 = Color3.new(1, 1, 1),
			TextSize = 10,
			Font = Enum.Font.GothamBold,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Parent = row,
		})
		corner(delB, 6)
		hoverify(delB, THEME.bad, Color3.fromRGB(120, 40, 48))

		bindClick(copyB, function()
			local lines = { "# JzScanner — " .. (e.name or ("Place " .. tostring(e.placeId))) }
			for _, rp in ipairs(e.remotes) do
				table.insert(lines, rp)
			end
			if #e.reqs > 0 then
				table.insert(lines, "-- requires:")
				for _, rid in ipairs(e.reqs) do
					table.insert(lines, "require(" .. rid .. ')("' .. PlayerName .. '")')
				end
			end
			if copyText(table.concat(lines, "\n")) then
				toast("Copied", #e.remotes .. " remotes + " .. #e.reqs .. " requires", THEME.accent)
