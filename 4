outputLine("> jzscanner " .. VERSION .. " ready · " .. State.bindCount .. " buttons wired")
log(
	"INFO",
	"JzScanner "
		.. VERSION
		.. " booted "
		.. BOOT_STAMP
		.. " · "
		.. #History.GetAll()
		.. " saved game(s)"
		.. " · "
		.. State.bindCount
		.. " buttons wired"
		.. " · "
		.. killedGhosts
		.. " stale window(s) removed"
)
log("INFO", "INSERT toggles UI · title-bar drag moves window · _ shrinks to ball")

if killedGhosts > 0 then
	toast("CLEANUP", killedGhosts .. " stale JzScanner window(s) removed.", THEME.warn)
end

if #History.GetAll() > 0 then
	History.RefreshNames()
end

pcall(function()
	local genv = getgenv and getgenv() or _G
	genv.JzScanner = {
		Version = VERSION,
		BootStamp = BOOT_STAMP,
		Config = CONFIG,
		State = State,
		Scan = function()
			if not State.scanning then
				task.spawn(runScan)
			end
		end,
		GetConfirmed = function()
			local out = {}
			for _, m in ipairs(State.results) do
				if m.hits > 0 then
					table.insert(out, m.remote)
				end
			end
			return out
		end,
		GetRequires = function()
			local out = {}
			for _, rq in ipairs(State.requires) do
				table.insert(out, rq.id)
			end
			return out
		end,
		CollectRequires = function()
			if not State.collecting then
				task.spawn(collectGameRequires)
			end
		end,
		GetHistory = function()
			return History.GetAll()
		end,
		ClearHistory = function()
			History.ClearAll()
			renderHistory()
		end,
		Execute = executeCurrent,
		Broadcast = hintBroadcast,
		Log = log,
		Gui = parentGui,
	}
end)

if State.settings.autoScan then
	task.delay(2, function()
		if not State.destroyed then
			log("INFO", "auto-scan starting...")
			task.spawn(runScan)
		end
	end)
end

